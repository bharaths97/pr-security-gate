# Optional local Docker smoke-test settings for AI narrative generation.
# Copy to .env.ai and fill in real values locally. Do not commit .env.ai.

# AI_PROVIDER can be auto, anthropic, openai, or none.
AI_PROVIDER=auto

# Anthropic is preferred when AI_PROVIDER=auto and this key is present.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI is used when AI_PROVIDER=auto and no Anthropic key is present,
# or when AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
